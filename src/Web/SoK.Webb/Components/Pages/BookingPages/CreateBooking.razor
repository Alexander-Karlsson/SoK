@page "/book"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SoK.Webb.Components.BookingComponents
@using SoK.Webb.Data
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Boka</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <h2>Boka</h2>
        @if (customerId is not null && createdId is null)
        {
            <button class="admin-btn admin-btn-primary" @onclick="SaveAsync" disabled="@(form?.IsBusy == true)">Skicka bokning</button>
        }
    </div>

    @if (loading)
    {
        <p class="empty">Laddar...</p>
    }
    else if (customerId is null)
    {
        <p class="empty">Ditt konto är inte kopplat till en kund. Kontakta oss så hjälper vi dig.</p>
    }
    else if (createdId is not null)
    {
        <p class="empty">Tack! Din bokning är mottagen.</p>
    }
    else
    {
        <BookingForm @ref="form" CustomerId="customerId" ShowEmployees="false" OnCreated="Created" />
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private BookingForm? form;
    private Guid? customerId;
    private Guid? createdId;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var user = await UserManager.GetUserAsync(state.User);
        customerId = user?.CustomerId;
        loading = false;
    }

    private async Task SaveAsync()
    {
        if (form is not null)
            await form.SaveAsync();
    }

    private void Created(Guid id) => createdId = id;
}