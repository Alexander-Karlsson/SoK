@page "/employeedetails/{Id:guid}"
@rendermode InteractiveServer
@using Employees.Application.Employees.DTOs.Employee
@using SoK.Webb.Clients
@inject EmployeeApiClient EmployeeClient
@inject NavigationManager Navigation

<PageTitle>Info om anställd</PageTitle>

<h3>EmployeeDetails</h3>

@if (employee is null)
{
    <p>Sidan Laddar...</p>
}
else
{
    <dl>
        <dt>Anställningsnummer</dt>
        <dd>@employee.EmployeeNumber</dd>

        <dt>Namn</dt>
        <dd>@employee.FirstName @employee.LastName</dd>
        
        <dt>Telefonnummer</dt>
        <dd>@employee.PhoneNumber</dd>
        
        <dt>Mail</dt>
        <dd>@employee.Email</dd>
        
        <dt>Address</dt>
        <dd>@employee.Address</dd>
        <dd>@employee.Zipcode @employee.City</dd>
        

        <dt>Nödkontakt</dt>
        <dd>@employee.EmergencyContactName</dd>
        <dd>@employee.EmergencyContactNumber</dd>

        <dt>Relation</dt>
        <dd>@employee.Relationship</dd>
        

        <dt>Titel</dt>
        <dd>@employee.Title</dd>
        
        <dt>Avdelning</dt>
        <dd>@employee.Department</dd>
        
        <dt>Sysselsättningsgrad (%)</dt>
        <dd>@employee.EmployeeRate</dd>
        
        <dt>Anställningsform</dt>
        <dd>@employee.EmployeeType</dd>
        
        <dt>Anställdes</dt>
        <dd>@employee.EmploymentStartDate</dd>
        
        <dt>Avslutar anställning</dt>
        <dd>@employee.EmploymentEndDate</dd>

        <dt>Semester dagar</dt>
        <dd>@employee.VacationDaysPerYear</dd>
        
        <dt>Aktiv</dt>
        <dd>@employee.IsActive</dd>
    </dl>
}

