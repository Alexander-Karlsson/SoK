@page "/mina-sidor/lediga-uppdrag"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Employee")]
@using Bookings.Application.Bookings.DTOs.Response
@using Employees.Application.Employees.DTOs.Employee
@using Employees.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SoK.Webb.Clients
@using SoK.Webb.Data
@inject UserManager<ApplicationUser> UserManager
@inject EmployeeApiClient EmployeeApiClient
@inject AssignmentApiClient AssignmentApiClient

<PageTitle>Lediga uppdrag</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <h2>Lediga uppdrag</h2>
        <a class="admin-btn admin-btn-secondary" href="/mina-sidor">← Tillbaka</a>
    </div>

    @if (message is not null)
    {
        <p class="assignment-success">@message</p>
    }

    @if (error is not null)
    {
        <p class="admin-alert admin-alert-error">@error</p>
    }

    @if (loading)
    {
        <p class="empty">Laddar...</p>
    }
    else if (employee is null)
    {
        <p class="empty">Ditt konto är inte kopplat till en anställd. Kontakta admin.</p>
    }
    else if (assignments is null || assignments.Count == 0)
    {
        <p class="empty">Det finns inga lediga uppdrag för @employee.Title.TranslateToSwedish().</p>
    }
    else
    {
        <div class="assignment-table-wrapper">
            <table class="assignment-table">
                <thead>
                    <tr>
                        <th>Tjänst</th>
                        <th>Start</th>
                        <th>Slut</th>
                        <th>Timmar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in assignments)
                    {
                        <tr>
                            <td>@a.ServiceName</td>
                            <td>@a.StartsAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.EndsAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.EstimatedHours.ToString("0.##")</td>
                            <td class="assignment-action">
                                <button class="admin-btn admin-btn-primary"
                                        @onclick="() => TakeAsync(a)"
                                        disabled="@busy">
                                    Ta uppdrag
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private EmployeeResponse? employee;
    private List<OpenAssignmentResponse>? assignments;
    private bool loading = true;
    private bool busy;
    private string? error;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var user = await UserManager.GetUserAsync(state.User);

        if (user?.EmployeeId is Guid employeeId)
        {
            try
            {
                // Titeln hämtas från Employees varje gång, den kan ha ändrats
                employee = await EmployeeApiClient.GetByIdAsync(employeeId);
            }
            catch (HttpRequestException)
            {
                error = "Kunde inte hämta dina uppgifter. Försök igen senare.";
            }

            if (employee is not null)
                await LoadAsync();
        }

        loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            // Titeln skickas som enum-namnet, samma som RequiredTitle på tjänsten
            assignments = await AssignmentApiClient.GetOpenAssignmentsAsync(employee!.Title.ToString());
        }
        catch (HttpRequestException)
        {
            assignments = [];
            error = "Kunde inte hämta lediga uppdrag. Försök igen senare.";
        }
    }

    private async Task TakeAsync(OpenAssignmentResponse assignment)
    {
        busy = true;
        message = null;
        error = await AssignmentApiClient.TakeServiceAsync(assignment.BookingId, assignment.ServiceId, employee!.Id);
        busy = false;

        if (error is null)
            message = $"Du har tagit {assignment.ServiceName}, {assignment.StartsAt:yyyy-MM-dd}.";

        // Ladda om i båda fallen: uppdraget kan ha tagits av någon annan
        await LoadAsync();
    }
}