@page "/"

<PageTitle>Skrot och Korn</PageTitle>

<div style="font-family: var(--font-heading); background-color: var(--color-beige);">

    <div class="position-relative">
        <img src="images/sok%20med%20logo.png" class="img-fluid w-100" alt="Skrot och Korn" />

        <div class="position-absolute bottom-0 start-0 m-4">
            <a href="#tjanster" class="btn fs-4 me-3" style="width: 200px; background-color: var(--color-yellow);">Våra tjänster</a>
            <a href="contact" class="btn fs-4" style="width: 200px; background-color: var(--color-yellow);">Om oss</a>
        </div>
    </div>

    <div class="container text-center py-4">

        <h2 id="tjanster" class="mb-4">Våra tjänster</h2>

        <div class="row">
            <div class="col-md-4 mb-3">
                <a href="#" class="btn btn-lg w-100 py-4" style="background-color: var(--color-blue); color: var(--color-text);">Hyr maskin</a>
            </div>
            <div class="col-md-4 mb-3">
                <a href="#" class="btn btn-lg w-100 py-4" style="background-color: var(--color-blue); color: var(--color-text);">Boka maskin + person</a>
            </div>
            <div class="col-md-4 mb-3">
                <a href="#" class="btn btn-lg w-100 py-4" style="background-color: var(--color-blue); color: var(--color-text);">Skicka projektförfrågan</a>
            </div>
        </div>

    </div>
</div>