@page "/invoices"
@using Invoices.Application.Dtos
@using SoK.Webb.Clients
@using SoK.Webb.Components.InvoiceComponents
@inject InvoiceApiClient InvoiceClient

<PageTitle>Fakturor</PageTitle>

<div class="invoice-page py-5">
    <div class="container">
        <h1 class="mb-4">Fakturor</h1>

        @if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="invoice-grid">
            @foreach (var i in Invoice)
            {
                <InvoiceCardComponent Invoice="i" />
            }
        </div>
    </div>
</div>

@code {
    private List<InvoiceResponse> Invoice { get; set; } = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Invoice = await InvoiceClient.GetAllAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunde inte hämta fakturor.";
        }
    }
}