@page "/templates/create"
@rendermode InteractiveServer

@using Invoices.Application.Dtos
@using SoK.Webb.Clients
@using SoK.Webb.Components.InvoiceComponents

@inject InvoiceApiClient InvoiceClient
@inject NavigationManager Navigation

<PageTitle>Skapa mall</PageTitle>

<div class="container py-5">
    <h2 class="mb-4">Skapa mall</h2>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <TemplateFormComponent Model="template" ButtonText="Skapa mall" OnValidSubmit="SaveTemplate" />
</div>

@code {
    private CreateTemplateRequest template = new()
    {
        CompanyName = "Skrot & Korn AB",
        CompanyNumber = "112233-4455",
        VatNumber = "SE112233445501",
        CompanyAddress = "Storgatan 1",
        CompanyPostalCode = "111 22",
        CompanyCity = "Örebro",
        CompanyPhone = "070-123 12 33",
        CompanyEmail = "faktura@sok.se",
        CompanyBankgiro = "123-4567",
        Logo = "images/logo.png",
        PrimaryColor = "#1f1f1b"
    };

    private string? errorMessage;

    private async Task SaveTemplate()
    {
        var success = await InvoiceClient.CreateTemplateAsync(template);

        if (success)
        {
            Navigation.NavigateTo("/templates");
        }
        else
        {
            errorMessage = "Det gick inte att spara mallen.";
        }
    }
}